        Lls = 3.4e-3
        Llr = 3.4e-3
        Lm  = 0.100
        pms = 2.0
        Jm  = 0.1
        alpha = .004    # temperature coefficient of resistivity [1/K]
        
        # Thermal Models
        # IM Thermal Parameters
        Rs_25 = Rs
        Rth_m = .07/5.0     # machine thermal resistance [K/W]
        Cth_m = 3700    # machine thermal capacitance [Ws/K]
        Tth_m = Rth_m*Cth_m    # machine thermal time constant [s]
        
        num_m = Rth_m
        den_m = [Tth_m, 1.0]
