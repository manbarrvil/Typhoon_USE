        <component_data>
                <id>b3fe21d44c5211ec877cdc8b28427f01</id>
                <name><![CDATA[Bar graph1]]></name>
                <type>BarGraphDisplay</type>
                <description><![CDATA[]]></description>
                <data_type>Expression</data_type>
                <code><![CDATA[# HIL API is imported as 'hil'
# NOTE: Only read functions are available from the HIL API

# SCADA API is imported as 'panel'
# SCADA API constants are imported as 'api_const'
# 'WIDGET_HANDLE' constant holds the WidgetHandle object of this widget.
# This object can be used as an argument in SCADA API functions.

# specify one bar data ('bar_name', 'value', 'minimum_value' and 'maximum_value' parts are mandatory)
rectifierLoss = hil.read_analog_signal(name='Efficiency calculation.p_loss_rectifier')
inverterLoss = hil.read_analog_signal(name='Efficiency calculation.p_loss_inverter')
mechLoss = hil.read_analog_signal(name='Efficiency calculation.p_loss_mech')
statosLoss = hil.read_analog_signal(name='Efficiency calculation.p_loss_stator')

sum = rectifierLoss + inverterLoss + mechLoss + statosLoss

maximum_value = sum
if(sum==0):
    maximum_value = 0.3
warning_value = 0.1
critical_value = maximum_value-0.1

barData1 = {
    # display name
    "bar_name": "Rectifier losses",
    # value to display
    "value": rectifierLoss,
    # value unit
    "unit": "W",
    # minimum value
    "minimum_value": 0.0,
    # maximum value
    "maximum_value": maximum_value,
    # show warning and critical values
    "use_warning_critical": True,
    # warning value
    "warning_value": warning_value,
    # critical value
    "critical_value": critical_value,
    }
    
barData2 = {
    # display name
    "bar_name": "Inverter losses",
    # value to display
    "value": inverterLoss,
    # value unit
    "unit": "W",
    # minimum value
    "minimum_value": 0.0,
    # maximum value
    "maximum_value": maximum_value,
    # show warning and critical values
    "use_warning_critical": True,
    # warning value
    "warning_value": warning_value,
    # critical value
    "critical_value": critical_value,
    }

barData3 = {
    # display name
    "bar_name": "Stator Losses",
    # value to display
    "value": statosLoss,
    # value unit
    "unit": "W",
    # minimum value
    "minimum_value": 0.0,
    # maximum value
    "maximum_value": maximum_value,
    # show warning and critical values
    "use_warning_critical": True,
    # warning value
    "warning_value": warning_value,
    # critical value
    "critical_value": critical_value,
    }
    
barData4 = {
    # display name
    "bar_name": "Mechanical losses",
    # value to display
    "value": mechLoss, 
    # value unit
    "unit": "W",
    # minimum value
    "minimum_value": 0.0,
    # maximum value
    "maximum_value": maximum_value,
    # show warning and critical values
    "use_warning_critical": True,
    # warning value
    "warning_value": warning_value,
    # critical value
    "critical_value": critical_value,
    }


# list of bars data: [barData1, barData2,...barData10]
displayValue = [barData1, barData2, barData3, barData4]
]]></code>
                <updateRate>500</updateRate>
                <bars_data>
                    </bars_data>
                <widget_settings>
                    <x>0</x>
                    <y>224</y>
                    <width>504</width>
                    <height>144</height>
                    <appearance><![CDATA[Raised]]></appearance>
