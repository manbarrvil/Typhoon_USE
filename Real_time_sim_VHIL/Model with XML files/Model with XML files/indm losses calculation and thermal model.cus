                <name><![CDATA[LVRT pulse]]></name>
                <type>Macro</type>
                <description><![CDATA[]]></description>
                <on_click_code active="True"><![CDATA[# NOTE: The code specified in this handler will be executed on button click.
# HIL API


source_settings = hil.get_source_settings('Va_grid')
Va_scaling = source_settings['scaling_value']

source_settings = hil.get_source_settings('Vb_grid')
Vb_scaling = source_settings['scaling_value']

source_settings = hil.get_source_settings('Vc_grid')
Vc_scaling = source_settings['scaling_value']

hil.set_source_scaling('Va_grid', 0.0)
hil.set_source_scaling('Vb_grid', 0.0)
hil.set_source_scaling('Vc_grid', 0.0)

hil.wait_sec(1)

hil.set_source_scaling('Va_grid', Va_scaling)
hil.set_source_scaling('Vb_grid', Vb_scaling)
hil.set_source_scaling('Vc_grid', Vc_scaling)]]></on_click_code>
