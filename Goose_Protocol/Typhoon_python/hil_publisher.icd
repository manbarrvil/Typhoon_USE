<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL" version="2007" revision="B">
  <Header id="HIL101_GOOSE" version="1.0"/>
  <Communication>
    <SubNetwork name="SubNetwork1" type="8-MMS">
      <ConnectedAP iedName="HIL_IED" apName="AP1">
        <GSE ldInst="CTRL" cbName="GoCB_Double">
          <Address>
            <P type="MAC-Address">01-0C-CD-01-00-01</P>
            <P type="APPID">0001</P>
            <P type="VLAN-ID">000</P>
            <P type="VLAN-PRIORITY">4</P>
          </Address>
        </GSE>
      </ConnectedAP>
    </SubNetwork>
  </Communication>
  <IED name="HIL_IED" manufacturer="TyphoonHIL">
    <AccessPoint name="AP1">
      <Server>
        <Authentication none="true"/>
        <LDevice inst="CTRL">
          <LN0 lnClass="LLN0" inst="" lnType="LLN0_Type">
            <!-- 8 valores publicados por GOOSE, en este orden (así los muestra
                 subscriber_goose.py): Va, Vb, Vc, Ia, Ib, Ic, P, Q -->
            <DataSet name="ds_DoubleVal">
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="PhV.phsA" daName="cVal.mag.f" fc="MX"/>
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="PhV.phsB" daName="cVal.mag.f" fc="MX"/>
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="PhV.phsC" daName="cVal.mag.f" fc="MX"/>
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="A.phsA" daName="cVal.mag.f" fc="MX"/>
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="A.phsB" daName="cVal.mag.f" fc="MX"/>
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="A.phsC" daName="cVal.mag.f" fc="MX"/>
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="TotW" daName="mag.f" fc="MX"/>
              <FCDA ldInst="CTRL" prefix="" lnClass="MMXU" lnInst="1" doName="TotVAr" daName="mag.f" fc="MX"/>
            </DataSet>
            <GSEControl name="GoCB_Double" datSet="ds_DoubleVal" confRev="2" appID="HIL_GOOSE_PUB" goID="HIL101_GOOSE"/>
          </LN0>
          <LN lnClass="MMXU" inst="1" prefix="" lnType="MMXU_Type"/>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>
</SCL>