                component "core/C function" "C function VSG2" {
                    arb_defs = "/*Begin code section*/

/*End code section*/"
                    execution_rate = "Ts_Control"
                    global_variables = "real x_p;real x_q;real theta;real x_isd;real x_isq;real e_p;real e_q;real x_ps;real x_qs;"
                    init_fnc = "/*Begin code section*/
x_p = 0.0;
x_q = 0.0;
theta = 0.0;
x_isd = 0.0;
x_isq = 0.0;
e_p = 0.0;
e_q = 0.0;
x_ps = 0.0;
x_qs = 0.0;
/*End code section*/"
                    input_terminals = "real p_m_ref;real q_s_ref;real is_albe;real vs_albe;real omega_base;real on_vsg;real theta_pll;real reset_int;"
                    input_terminals_dimensions = "1;1;2;2;1;1;1;1"
                    input_terminals_feedthrough = "True;True;True;True;True;True;True;True"
                    input_terminals_show_labels = "True;True;True;True;True;True;True;True"
                    output_fnc = "/*Begin code section*/
//omega VSG rads
omega_vsg = (Kp_p*e_p + x_p + omega_base)*2.0*M_PI*50.0;
//theta VSG

theta_vsg= theta;
//if (on_vsg<0.5){
//    theta_vsg = theta_pll;
//}
// current dq transformation
is_d= is_albe[0]*cos(theta_vsg)+ is_albe[1]*sin(theta_vsg);
is_q = -is_albe[0]*sin(theta_vsg) + is_albe[1]*cos(theta_vsg);

// voltage dq transformation
vs_d= vs_albe[0]*cos(theta_vsg)+ vs_albe[1]*sin(theta_vsg);
vs_q = -vs_albe[0]*sin(theta_vsg) + vs_albe[1]*cos(theta_vsg);

//if (time<=T_on_contactor){
//    vs_q = -sqrt(pow(vs_d,2)+pow(vs_q,2));
//    vs_d = 0.0;
    
//}
// powers in pu
p_s = (is_d* vs_d + is_q*vs_q)/(I_bdq*U_bdq);
q_s = (is_d* vs_q -  is_q*vs_d)/(I_bdq*U_bdq);
p_s_fil = x_ps;
q_s_fil = x_qs;
//p_s = (is_albe[0]* vs_albe[0] +  is_albe[1]*vs_albe[1])/(I_bdq*U_bdq);
//q_s = (is_albe[0]* vs_albe[1] -  is_albe[1]*vs_albe[0])/(I_bdq*U_bdq);

if (on_vsg<0.5){
    p_s = 0.0;
    q_s = 0.0;
}

// electromotive force pu
e = e_o + Kp_q*e_q + x_q;

//current references SI
is_dq_ref[0] = -I_bdq*(Xv*e + Rv*vs_d/U_bdq + Xv*vs_q/U_bdq)/(pow(Rv,2)+pow(Xv,2));
is_dq_ref[1] = -I_bdq*(Rv*e + Rv*vs_q/U_bdq - Xv*vs_d/U_bdq)/(pow(Rv,2)+pow(Xv,2));


//current references SI filtered
is_dq_ref_fil[0] = x_isd;
is_dq_ref_fil[1] = x_isq;

if (on_vsg<0.5){
    is_dq_ref[0] = 0.0;
    is_dq_ref[1] = 0.0;
}
/*End code section*/"
                    output_terminals = "real is_dq_ref;real omega_vsg;real theta_vsg;real e;real p_s;real q_s;real is_dq_ref_fil;inherit is_d;inherit is_q;inherit vs_d;inherit vs_q;real p_s_fil;real q_s_fil;"
                    output_terminals_dimensions = "2;1;1;1;1;1;2;1;1;1;1;1;1"
                    output_terminals_feedthrough = "True;True;True;True;True;True;True;True;True;True;True;True;True"
                    output_terminals_show_labels = "True;True;True;True;True;True;True;True;True;True;True;True;True"
                    parameters = "real Kp_p;real Ki_p;real Kp_q;real Ki_q;real Xv;real Rv;real I_bdq;real e_o;real U_bdq;real Ts_Control;real tau_vsg;real T_on_contactor;"
                    update_fnc = "/*Begin code section*/
//active and reactive power error pu

e_p = p_m_ref - p_s;
//e_p = p_m_ref - p_s_fil;
e_q = q_s_ref - q_s;
//e_q = q_s_ref - q_s_fil;

//integrator PI active adn reactive power
x_p = x_p + Ki_p*Ts_Control*e_p;
x_q = x_q + Ki_q*Ts_Control*e_q;

//integrator omega rad
theta = theta + omega_vsg*Ts_Control;
if (reset_int<0.5){
    theta = theta_pll;
    x_p = 0.0;
    x_q = 0.0;
}

if (theta>=2*M_PI){
    theta = theta - 2*M_PI;
}
//if (theta<0.0){
//    theta = theta + abs(theta);
//}

//filter of the reference currents
x_isd = x_isd + Ts_Control*2*M_PI*1/(tau_vsg)*(is_dq_ref[0] - x_isd);
x_isq = x_isq + Ts_Control*2*M_PI*1/(tau_vsg)*(is_dq_ref[1] - x_isq);
x_ps = x_ps + Ts_Control*2*M_PI*1/(tau_vsg)*(p_s - x_ps);
x_qs = x_qs + Ts_Control*2*M_PI*1/(tau_vsg)*(q_s - x_qs);

//if (time<=T_on_contactor){
//    x_p = 0.0;
//    theta = 0.0;
//    x_q = 0.0;
//}
/*End code section*/"
                }
