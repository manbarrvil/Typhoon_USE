                component "core/C function" "C function abc to dq" {
                    arb_defs = "/*Begin code section*/

/*End code section*/"
                    execution_rate = "Ts_Control"
                    init_fnc = "/*Begin code section*/

/*End code section*/"
                    input_terminals = "real abc;real theta;"
                    input_terminals_dimensions = "3;1"
