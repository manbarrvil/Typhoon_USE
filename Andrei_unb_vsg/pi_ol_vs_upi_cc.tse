    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        # The Schematic API is imported as 'mdl'
        # To get the model file path, use 'mdl.get_model_file_path()'
        # To print information to the console, use info()
        fc = 50
        omega = 2*np.pi*50
        R_12_13 = 0.06*4
        L_12_13 = 0.06275*4/omega
        R_13_14 = 0.025*4
        L_13_14 = 0.01575*4/omega
        L_t = 2.5e-3
        C = 1e-6
        L_s = 2.5e-3
        R_d = 27
        R_t = omega*L_t/10
        R_s = omega*L_s/10
        Ts = 50e-6
        AO_offset = 1.5
        I_scale = 90/3 #105 max volta - (-150) min voltage. 3 max voltage DSP
        V_scale = 720/3 #360 max volta - (-360) min voltage. 3 max voltage DSP
        Tslow = 100e-3
        Ts_Control = 50e-6
        
        #PLL control gains
        K_p_pll = 1.8
        K_i_pll = 1.8/0.00251
        
        # PI current controller gains
        tau_c = 1e-3
        L = L_s + L_t
        R = R_s + R_t
        Ln = L
        Rn = R
        Kp_i = 2*L/tau_c
        Ki_i = R/tau_c
        Kr_i = 2*Ki_i
        
        #Ton contactor
        T_on_contactor = 0.1
        
        #rads to hertz
        rad_2_hertz= 1/(2*np.pi)
        
        omega_base_rads = 2*np.pi*50
        
        #VSG 
        S_b = 20e3
        U_b = 400
        I_b = S_b/(np.sqrt(3)*U_b)
        I_bdq = I_b*np.sqrt(2)
        U_bdq = U_b*(np.sqrt(2/3))
        
        # PI-CC
        H = 5.0  # desired virtual inertia 
        Kp_p = 0.015  # active power proportinal gain
        Ki_p = 1.0/(2.0*H)  # proportional gain active power control loop
        Kp_q = 0.1
        Ki_q = 0.1
        Xv = 0.40
        Rv = 0.0
        e_o = 1.0
        omega_base = 1.0
        omega_base_rads = 2*np.pi*50
        f_base_rads = 50
        #LPF VSG
        tau_vsg = 2.4e-3
        #tau_vsg = 10e-3
        
        # PI-OL
        Kp_p_ol = 0.0764
        Ki_p_ol = Ki_p
        
        period = 20e-3
        #dead time
        dt = 0.1e-6
        
        # Resonant Impulse Invariant
        #d = 0.0
        B = 4.99938316240830e-05
        C = 1.99975326496332
        D = 1
        #d = 0.001
        #B = 4.99938316886773e-05
        #C = 1.99972185340592
        #D = 0.999968584566939
        #d = 0.002
        #B = 4.99938317532706e-05
        #C = 1.99969044283538
        #D = 0.999937170120808
    ENDCODE
