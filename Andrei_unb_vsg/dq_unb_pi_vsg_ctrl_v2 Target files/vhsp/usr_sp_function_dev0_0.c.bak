                    _plant_single_phase_power_meter3_va_rms__out_state = sqrt(_plant_single_phase_power_meter3_va_rms__square_sum / _plant_single_phase_power_meter3_va_rms__sample_cnt);
                    _plant_single_phase_power_meter3_va_rms__sample_cnt = 0;
                    _plant_single_phase_power_meter3_va_rms__square_sum = 0;
                }

                _plant_single_phase_power_meter3_va_rms__previous_value = _plant_vc_va1__out;
                _plant_single_phase_power_meter3_va_rms__square_sum += _plant_vc_va1__out * _plant_vc_va1__out;
                _plant_single_phase_power_meter3_va_rms__sample_cnt ++;

    //@cmp.update.block.end
}
