        component "core/C function" "C function ODE" {
            arb_defs = "/*Begin code section*/

/*End code section*/"
            execution_rate = "Ts_Control"
            global_variables = "real it_d;real it_q;real vc_d;real vc_q;real is_d;real is_q;real dis_d_ant;real dis_q_ant;real dit_d_ant;real dit_q_ant;real dvc_d_ant;real dvc_q_ant;"
            init_fnc = "/*Begin code section*/
it_d = 0.0;
it_q = 0.0;
vc_d = 0.0;
vc_q = 0.0;
is_d = 0.0;
is_q = 0.0;
dit_d_ant = 0.0;
dit_q_ant = 0.0;
dvc_d_ant = 0.0;
dvc_q_ant = 0.0;
dis_d_ant = 0.0;
dis_q_ant = 0.0;
/*End code section*/"
            input_terminals = "real omega;inherit vt_d;inherit vt_q;inherit vs_d;inherit vs_q;inherit time;"
            input_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit"
            input_terminals_feedthrough = "True;True;True;True;True;True"
            input_terminals_show_labels = "True;True;True;True;True;True"
            output_fnc = "/*Begin code section*/
//ODE of the plant
//Converter-side dynamic
//vt_d = Rt*it_d + Lt*dit_d - omega*Lt*it_q + vm_d
//vt_q = Rt*it_q + Lt*dit_q + omega*Lt*it_d + vm_q
//vt_d = Rt*it_d + Lt*dit_d - omega*Lt*it_q + vc_d + ic_d*Rd
//vt_q = Rt*it_q + Lt*dit_q + omega*Lt*it_d + vc_q + ic_q*Rd
//vt_d = Rt*it_d + Lt*dit_d - omega*Lt*it_q + vc_d + (it_d - is_d)*Rd
//vt_q = Rt*it_q + Lt*dit_q + omega*Lt*it_d + vc_q + (it_q - is_q)*Rd

//Mid point dynamic
//vm_d = vc_d + ic_d*Rd
//vm_q = vc_q + ic_q*Rd
//vm_d = vc_d + C*Rd*dvc_d -omega_C*Rd*vc_q
//vm_q = vc_q + C*Rd*dvc_q +omega_C*Rd*vc_d
//ic_d = it_d - is_d
//ic_q = it_q - is_q
//C*dvc_d -omega*C*vc_q = it_d - is_d
//C*dvc_q +omega*C*vc_d = it_q - is_q

//Grid-side dynamic
//vm_d = Rs*is_d + Ls*dis_d - omega*Ls*is_q + vs_d
//vm_q = Rs*is_q + Ls*dis_q + omega*Ls*is_d + vs_q
//vc_d + ic_d*Rd = Rs*is_d + Ls*dis_d - omega*Ls*is_q + vs_d
//vc_q + ic_q*Rd = Rs*is_q + Ls*dis_q + omega*Ls*is_d + vs_q
//vc_d + (it_d - is_d)*Rd = Rs*is_d + Ls*dis_d - omega*Ls*is_q + vs_d
//vc_q + (it_q - is_q)*Rd = Rs*is_q + Ls*dis_q + omega*Ls*is_d + vs_q
//dit_d =  it_q*omega + Rd*is_d/Lt - Rd*it_d/Lt - Rt*it_d/Lt - vc_d/Lt + vt_d/Lt;
dit_d =  1.0/Lt*(Lt*it_q*omega  + Rd*is_d - Rd*it_d - Rt*it_d - vc_d + vt_d);
//dit_q = -it_d*omega + Rd*is_q/Lt - Rd*it_q/Lt - Rt*it_q/Lt - vc_q/Lt + vt_q/Lt;
dit_q =  1.0/Lt*(-Lt*it_d*omega + Rd*is_q - Rd*it_q - Rt*it_q - vc_q + vt_q);
dvc_d =  omega*vc_q - is_d/C + it_d/C; 
dvc_q = -omega*vc_d - is_q/C + it_q/C;
dis_d =  1/Ls*(Ls*is_q*omega  - Rd*is_d + Rd*it_d - Rs*is_d + vc_d - vs_d);
dis_q =  1/Ls*(-is_d*Ls*omega - Rd*is_q + Rd*it_q - Rs*is_q + vc_q - vs_q);
//dis_d = vt_d/(Ls+Lt) - vs_d/(Ls+Lt) - (Rs+Rt)*is_d/(Ls+Lt) + is_q*omega;
//dis_q = vt_q/(Ls+Lt) - vs_q/(Ls+Lt) - (Rs+Rt)*is_q/(Ls+Lt) - is_d*omega;

it_d_out = it_d;
it_q_out = it_q;
vc_d_out = vc_d;
vc_q_out = vc_q;
is_d_out = is_d;
is_q_out = is_q;
/*End code section*/"
            output_terminals = "real it_d_out;inherit it_q_out;inherit vc_d_out;inherit vc_q_out;inherit is_d_out;inherit is_q_out;inherit dit_d;inherit dit_q;inherit dvc_d;inherit dvc_q;inherit dis_d;inherit dis_q;"
            output_terminals_dimensions = "inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit;inherit"
            output_terminals_feedthrough = "True;True;True;True;True;True;True;True;True;True;True;True"
            output_terminals_show_labels = "True;True;True;True;True;True;True;True;True;True;True;True"
            parameters = "real Ls;real Rs;real Lt;real Rt;real C;real Rd;real Ts_Control;real T_on_contactor;"
            update_fnc = "/*Begin code section*/
//Backward Euler method
//it_d = it_d + (dit_d)*Ts_Control;
//it_q = it_q + (dit_q)*Ts_Control;
//vc_d = vc_d + (dvc_d)*Ts_Control;
//vc_q = vc_q + (dvc_q)*Ts_Control;
//is_d = is_d + (dis_d)*Ts_Control;
//is_q = is_q + (dis_q)*Ts_Control;


//Trapezoidal method
it_d = it_d + (Ts_Control / 2.0) * (dit_d + dit_d_ant);
it_q = it_q + (Ts_Control / 2.0) * (dit_q + dit_q_ant);
vc_d = vc_d + (Ts_Control / 2.0) * (dvc_d + dvc_d_ant);
vc_q = vc_q + (Ts_Control / 2.0) * (dvc_q + dvc_q_ant);
is_d = is_d + (Ts_Control / 2.0) * (dis_d + dis_d_ant);
is_q = is_q + (Ts_Control / 2.0) * (dis_q + dis_q_ant);

dit_d_ant = dit_d;
dit_q_ant = dit_q;
dvc_d_ant = dvc_d;
dvc_q_ant = dvc_q;
dis_d_ant = dis_d;
dis_q_ant = dis_q;

//if (time<0.1){
//    it_d = 0.0 ; 
//    it_d = 0.0 ; 
//    vc_d = 325.2691 ; 
//    vc_q = 0.0 ; 
//    is_d = 0.0 ; 
//    is_d = 0.0 ; 
//}
/*End code section*/"
        }
