                global_variables = "real e_p;real y_lpf;real y_hpf;real u_hpf;real int_1;"
                init_fnc = "/*Begin code section*/
y_lpf = 0.0;
y_hpf = 0.0;
u_hpf = 0.0;
int_1 = 0.0;
e_p = 0.0;
/*End code section*/"
                input_terminals = "real p_m_ref;inherit p;inherit time;"
                input_terminals_dimensions = "inherit;inherit;inherit"
                input_terminals_feedthrough = "True;True;True"
                input_terminals_show_labels = "True;True;True"
                output_fnc = "/*Begin code section*/
delta_omega = (F*e_p + int_1)/K;

if (time<T_on_VSG){
    delta_omega = 0.0;
}
/*End code section*/"
                output_terminals = "real delta_omega;"
                output_terminals_dimensions = "inherit"
                output_terminals_feedthrough = "True"
                output_terminals_show_labels = "True"
                parameters = "real F;real T_on_contactor;real K;real T_filter;real Gain_hpf;real Gain_lpf;real S_b;real Ts_Control;real Ki_p;real T_on_VSG;"
                update_fnc = "/*Begin code section*/
e_p = p_m_ref - p/S_b;

y_lpf = y_lpf + (Ts_Control/T_filter)*(Gain_lpf*e_p - y_lpf);

y_hpf = y_hpf - y_hpf*Ts_Control/T_filter + Gain_hpf*e_p - u_hpf;

u_hpf = Gain_hpf*e_p;

int_1 = int_1 + Ki_p*(y_hpf + y_lpf)*Ts_Control;

if (time<T_on_contactor){
    int_1 = 0.0;
}
/*End code section*/"
