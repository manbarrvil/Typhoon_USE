    CODE model_init
        # Numpy module is imported as 'np'
        # Scipy module is imported as 'sp'
        Tfast = 50e-6
        Ts_Control = 50e-6
        Ts_Power = 0.1e-6
        #LPF power
        fc = 30
        # Filter parameter
        Lt = 1.25e-3
        Rt = .1
        Ls = 1.25e-3
        Rs = .1
        Rd = 10
        C = 4e-6
        # Switching frequency
        fs = 10e3
        #dead time
        dt = 0.1e-6
        
        #PLL control gains
        K_p_pll = 1.8
        K_i_pll = 1.8/0.00251
        
        # PI current controller gains
        tau_c = 1e-3
        L = Ls + Lt
        R = Rs + Rt
        Kp_i = L/tau_c
        Ki_i = R/tau_c
        
        #Ton contactor
        T_on_contactor = 0.5
        T_VSG = 0.5
        T_on_VSG = 0.5
        
        #VSG
        S_b = 20e3
        U_b = 400
        I_b = S_b/(np.sqrt(3)*U_b)
        Z_b = U_b*U_b/S_b
        I_bdq = I_b*np.sqrt(2)
        U_bdq = U_b*(np.sqrt(2/3))
        
        # desired virtual inertia 
        H = 5
        # active power proportinal gain
        Kp_p = 0.01 
        #proportional gain active power control loop
        Ki_p = 1.0/(2.0*H) 
        Kp_q = 0.1
        Ki_q = 10.0
        Xv = 0.1
        Rv = 0.0
        e_o = 1.0
        omega_base = 1.0
        
        #LPF VSG
        tau_vsg = 2.4e-3
        
        Ts_scope = 500e-6
        
        ##E-VSG
        Scc = 5e6
        Zcc = U_b*U_b/Scc
        omega = 2*np.pi*50
        X_grid_pu = 0.1
        X_grid = X_grid_pu*Zcc
        L_grid = X_grid/omega
        Xt = X_grid_pu*Zcc/Z_b + Xv
        Ks = 1/Xt
        K_g = omega*Ks
        omega_no = np.sqrt(K_g/(2*5)) # omega de referencia se estable para H=5s
        #frecuencia natual
        omega_n = 1*omega_no  
        alpha = 10
        #damping
        delta = 1.0 
        
        K = K_g/(alpha*delta*omega_n*omega_n*omega_n)
        F = (alpha + 2)/(alpha*omega_n*omega_n) - 2*H/K_g
        
        T = (2*alpha*delta*delta + 1)/(alpha*delta*omega_n)
        K_p = T/(2*H)/K
        K_p2 = F/K/K
        
        #E-PI-VSG
        Tz = K*T-2*H*F
        Tp = K/(2*H)
        T_filter = K/(2*H)
        Gain_hpf = 2*H/K*(K*T-2*H*F)
        Gain_lpf = K
    ENDCODE
}
